# ============================================================================
# MetroLens - Department of Consumer Affairs Environment Configuration
# ============================================================================

# Google Gemini API Configuration (Multimodal Vision Extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Google Cloud Project Identifiers
PROJECT_ID=
PROJECT_NUMBER=

# Cryptographic Session & Authentication Secret (Change in production)
SESSION_SECRET=metrolens-doca-gov-in-secret-key-2026-auth

# Database URL (Defaults to SQLite in project root)
DATABASE_URL=sqlite:///./database.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
